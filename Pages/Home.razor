@page "/"

<PageTitle>PomegranatePDF - Unisci e Ruota PDF</PageTitle>

<div class="container py-4" style="max-width: 900px;">
    <header class="mb-4">
        <h1 class="h2 fw-bold mb-1">PomegranatePDF</h1>
        <p class="text-muted mb-0">
            Carica più file PDF, ruotali, cambia l'ordine e uniscili in un unico documento.
            Elaborazione 100% locale nel browser (nessun file viene inviato in rete).
        </p>
    </header>

    <section class="card shadow-sm mb-4">
        <div class="card-body">
            <label for="pdfInput" class="form-label fw-semibold">Aggiungi uno o più file PDF</label>
            <InputFile id="pdfInput"
                       class="form-control"
                       OnChange="HandleFilesSelectedAsync"
                       multiple
                       accept=".pdf,application/pdf"
                       disabled="@IsBusy" />
            <div class="form-text">
                Puoi selezionare più file insieme o aggiungerli in più riprese (max 50 MB per file).
            </div>
        </div>
    </section>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@ErrorMessage</div>
    }

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="alert alert-success" role="alert">@StatusMessage</div>
    }

    @if (Workspace.Documents.Count == 0)
    {
        <div class="text-center text-muted border rounded-3 py-5 bg-light">
            Nessun PDF caricato. Seleziona almeno un file per iniziare.
        </div>
    }
    else
    {
        <section class="card shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center bg-white">
                <span class="fw-semibold">
                    Documenti in coda (@Workspace.Documents.Count) &mdash; @Workspace.TotalPages pagine totali
                </span>
                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        @onclick="Workspace.Clear"
                        disabled="@IsBusy">
                    Svuota lista
                </button>
            </div>

            <ul class="list-group list-group-flush">
                @for (var i = 0; i < Workspace.Documents.Count; i++)
                {
                    var doc = Workspace.Documents[i];
                    var isFirst = i == 0;
                    var isLast = i == Workspace.Documents.Count - 1;

                    <li class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-3 py-3">
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge bg-secondary rounded-pill">@(i + 1)</span>

                            <div class="border rounded d-flex align-items-center justify-content-center bg-light"
                                 style="width: 38px; height: 48px; transform: rotate(@(doc.RotationDegrees)deg); transition: transform 0.2s ease;"
                                 title="Orientamento attuale: @(doc.RotationDegrees)°">
                                <span class="small fw-bold text-primary">PDF</span>
                            </div>

                            <div>
                                <div class="fw-semibold text-break">@doc.FileName</div>
                                <div class="small text-muted">
                                    @doc.PageCount @(doc.PageCount == 1 ? "pagina" : "pagine")
                                    &bull; @doc.FormattedSize
                                    &bull; Rotazione: <strong>@(doc.RotationDegrees)°</strong>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <div class="btn-group btn-group-sm" role="group" aria-label="Rotazione">
                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        title="Ruota 90° a sinistra"
                                        @onclick="() => Workspace.RotateLeft(doc.Id)"
                                        disabled="@IsBusy">
                                    &#8634; -90°
                                </button>
                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        title="Ruota 90° a destra"
                                        @onclick="() => Workspace.RotateRight(doc.Id)"
                                        disabled="@IsBusy">
                                    &#8635; +90°
                                </button>
                            </div>

                            <div class="btn-group btn-group-sm" role="group" aria-label="Ordine">
                                <button type="button"
                                        class="btn btn-outline-primary"
                                        title="Sposta su"
                                        @onclick="() => Workspace.MoveUp(doc.Id)"
                                        disabled="@(IsBusy || isFirst)">
                                    &uarr;
                                </button>
                                <button type="button"
                                        class="btn btn-outline-primary"
                                        title="Sposta giù"
                                        @onclick="() => Workspace.MoveDown(doc.Id)"
                                        disabled="@(IsBusy || isLast)">
                                    &darr;
                                </button>
                            </div>

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    title="Rimuovi documento"
                                    @onclick="() => Workspace.RemoveDocument(doc.Id)"
                                    disabled="@IsBusy">
                                &times;
                            </button>
                        </div>
                    </li>
                }
            </ul>
        </section>

        <section class="card shadow-sm">
            <div class="card-body d-flex flex-wrap align-items-end justify-content-between gap-3">
                <div class="flex-grow-1" style="min-width: 240px;">
                    <label for="outputName" class="form-label fw-semibold">Nome file finale (opzionale)</label>
                    <input id="outputName"
                           type="text"
                           class="form-control"
                           placeholder="Lascia vuoto per nome automatico con timestamp"
                           @bind="OutputFileName"
                           disabled="@IsBusy" />
                </div>

                <button type="button"
                        class="btn btn-primary btn-lg"
                        @onclick="MergeAndDownloadAsync"
                        disabled="@IsBusy">
                    @if (IsBusy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Elaborazione...</span>
                    }
                    else
                    {
                        <span>Unisci e Scarica PDF</span>
                    }
                </button>
            </div>
        </section>
    }
</div>
