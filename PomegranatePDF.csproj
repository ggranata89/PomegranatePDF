<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Version>1.0.2</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <DefaultItemExcludes>$(DefaultItemExcludes);PomegranatePDF.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.1" PrivateAssets="all" />
    <PackageReference Include="PDFsharp" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- Preserva gli assembly PDFsharp dal trimming in Release (necessario per PdfSharpLicense in Blazor WASM) -->
    <TrimmerRootAssembly Include="PdfSharp" />
    <TrimmerRootAssembly Include="PdfSharp.License" />
    <TrimmerRootAssembly Include="PdfSharp.Shared" />
    <TrimmerRootAssembly Include="PdfSharp.System" />
    <TrimmerRootAssembly Include="PdfSharp.Cryptography" />
  </ItemGroup>

</Project>
