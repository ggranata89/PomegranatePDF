@inherits LayoutComponentBase
@using System.Reflection

<div class="page">
    <main>
        <article class="content px-3 px-md-4">
            @Body
        </article>
    </main>

    <footer class="border-top bg-light py-3 px-3 px-md-4 mt-auto">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2 small text-muted" style="max-width: 960px;">
            <span>&copy; @DateTime.Now.Year Giuseppe Granata</span>
            <span>
                Licenza
                <a href="https://www.gnu.org/licenses/agpl-3.0.html" target="_blank" rel="noopener noreferrer" class="link-secondary">
                    GNU AGPLv3
                </a>
                &bull;
                <a href="https://github.com/ggranata89/PomegranatePDF" target="_blank" rel="noopener noreferrer" class="link-secondary">
                    Codice sorgente
                </a>
            </span>
            <span>v@(AppVersion)</span>
        </div>
    </footer>
</div>

@code {
    private static string AppVersion
    {
        get
        {
            var version = typeof(MainLayout).Assembly.GetName().Version;
            return version is null ? "1.0.0" : $"{version.Major}.{version.Minor}.{version.Build}";
        }
    }
}
